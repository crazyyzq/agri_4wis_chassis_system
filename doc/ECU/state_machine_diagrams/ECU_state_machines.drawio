        <mxCell id="36" ecuRole="panel" value="&lt;b&gt;T10&lt;/b&gt;&amp;nbsp;&amp;nbsp;CH14 方向稳定&lt;br&gt;&lt;b&gt;T11&lt;/b&gt;&amp;nbsp;&amp;nbsp;下一周期仍有效&lt;br&gt;&lt;b&gt;T12&lt;/b&gt;&amp;nbsp;&amp;nbsp;CH14 回中&lt;br&gt;&lt;b&gt;T13&lt;/b&gt;&amp;nbsp;&amp;nbsp;5 s 内重新拨动&lt;br&gt;&lt;b&gt;T14&lt;/b&gt;&amp;nbsp;&amp;nbsp;回中保持满 5 s&lt;br&gt;&lt;b&gt;T15&lt;/b&gt;&amp;nbsp;&amp;nbsp;已选悬挂 + D/R&lt;br&gt;&lt;b&gt;T16&lt;/b&gt;&amp;nbsp;&amp;nbsp;选择目标&lt;br&gt;&lt;b&gt;T17&lt;/b&gt;&amp;nbsp;&amp;nbsp;档位回 P" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#172B4D;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="812" y="1130" width="720" height="240" as="geometry" />
        </mxCell>
