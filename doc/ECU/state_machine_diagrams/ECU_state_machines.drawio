        <mxCell id="41" ecuRole="panel" value="&lt;b&gt;T01&lt;/b&gt;&amp;nbsp;&amp;nbsp;拨到开启端&lt;br&gt;&lt;b&gt;T02&lt;/b&gt;&amp;nbsp;&amp;nbsp;长按完成 + 前置条件满足&lt;br&gt;&lt;b&gt;T03&lt;/b&gt;&amp;nbsp;&amp;nbsp;条件不满足&lt;br&gt;&lt;b&gt;T04&lt;/b&gt;&amp;nbsp;&amp;nbsp;拨到关闭端&lt;br&gt;&lt;b&gt;T05&lt;/b&gt;&amp;nbsp;&amp;nbsp;长按完成 + 安全关断条件&lt;br&gt;&lt;b&gt;T06&lt;/b&gt;&amp;nbsp;&amp;nbsp;仍运动 / 未制动 / 液压未停&lt;br&gt;&lt;b&gt;T07&lt;/b&gt;&amp;nbsp;&amp;nbsp;原高压锁存仍有效&lt;br&gt;&lt;b&gt;T08&lt;/b&gt;&amp;nbsp;&amp;nbsp;开启请求失败且未形成高压锁存&lt;br&gt;&lt;b&gt;T09&lt;/b&gt;&amp;nbsp;&amp;nbsp;急停或 A 类故障&lt;br&gt;&lt;b&gt;T10&lt;/b&gt;&amp;nbsp;&amp;nbsp;故障解除且高压请求仍锁存" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#172B4D;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="66" y="1120" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="42" ecuRole="panel" value="&lt;b&gt;T11&lt;/b&gt;&amp;nbsp;&amp;nbsp;故障解除后再次低端长按 / 且关断条件满足&lt;br&gt;&lt;b&gt;T12&lt;/b&gt;&amp;nbsp;&amp;nbsp;控制权拨杆请求自动&lt;br&gt;&lt;b&gt;T13&lt;/b&gt;&amp;nbsp;&amp;nbsp;P + 零速 + 中位 / 自动请求有效&lt;br&gt;&lt;b&gt;T14&lt;/b&gt;&amp;nbsp;&amp;nbsp;授权条件不足&lt;br&gt;&lt;b&gt;T15&lt;/b&gt;&amp;nbsp;&amp;nbsp;取消自动请求&lt;br&gt;&lt;b&gt;T16&lt;/b&gt;&amp;nbsp;&amp;nbsp;人工操纵 / 自动失效 / 安全故障&lt;br&gt;&lt;b&gt;T17&lt;/b&gt;&amp;nbsp;&amp;nbsp;低油门 + 转向中位&lt;br&gt;&lt;b&gt;T18&lt;/b&gt;&amp;nbsp;&amp;nbsp;新操作替换旧租约&lt;br&gt;&lt;b&gt;T19&lt;/b&gt;&amp;nbsp;&amp;nbsp;消费一次或到期&lt;br&gt;&lt;b&gt;T20&lt;/b&gt;&amp;nbsp;&amp;nbsp;清理" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#172B4D;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="812" y="1120" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="43" ecuRole="panel" value="源码依据：remote_power_fsm.c · remote_authority_fsm.c · remote_event_lifecycle.c" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#5E6C84;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="800" y="1452" width="750" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel></diagram>
  <diagram id="ecu-fsm-6" name="06 CAN2 实时 PDO 调度与自动恢复"><mxGraphModel dx="1600" dy="1480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" math="0" shadow="0">
